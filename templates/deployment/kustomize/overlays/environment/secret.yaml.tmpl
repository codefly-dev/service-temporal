{{- if .Restricted -}}
# The restricted profile serializes no secret values. POSTGRES_USER and
# POSTGRES_PWD are consumed from externally-managed Secret references.
{{- else -}}
apiVersion: v1
kind: Secret
metadata:
  name: "temporal-{{ .Service.Name.DNSCase }}-secrets"
  namespace: {{ .Namespace }}
type: Opaque
data:
{{- range $key, $value := .SecretMap }}
  {{ $key }}: "{{ $value }}"
{{- end }}
{{- end -}}
