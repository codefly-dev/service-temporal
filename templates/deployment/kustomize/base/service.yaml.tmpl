apiVersion: v1
kind: Service
metadata:
  name: "temporal-{{ .Service.Name.DNSCase }}"
  namespace: "{{ .Namespace }}"
spec:
  selector:
    app: "temporal-{{ .Service.Name.DNSCase }}"
  ports:
    - protocol: TCP
      name: grpc
      port: 7233
      targetPort: 7233
    - protocol: TCP
      name: http
      port: 8233
      targetPort: 8233
