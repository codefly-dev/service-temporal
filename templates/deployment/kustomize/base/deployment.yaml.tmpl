apiVersion: apps/v1
kind: Deployment
metadata:
  name: "temporal-{{ .Service.Name.DNSCase }}"
  namespace: "{{ .Namespace }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: "temporal-{{ .Service.Name.DNSCase }}"
  template:
    metadata:
      labels:
        app: "temporal-{{ .Service.Name.DNSCase }}"
    spec:
      containers:
        - name: temporal
          image: temporalio/auto-setup:1.25.2
          ports:
            - containerPort: 7233
              name: grpc
            - containerPort: 8233
              name: http
          env:
            - name: DB
              value: "postgres12_pgx"
            - name: SKIP_DB_CREATE
              value: "false"
            - name: POSTGRES_SEEDS
              valueFrom:
                secretKeyRef:
                  name: "temporal-{{ .Service.Name.DNSCase }}-secrets"
                  key: POSTGRES_SEEDS
            - name: POSTGRES_USER
              valueFrom:
                secretKeyRef:
                  name: "temporal-{{ .Service.Name.DNSCase }}-secrets"
                  key: POSTGRES_USER
            - name: POSTGRES_PWD
              valueFrom:
                secretKeyRef:
                  name: "temporal-{{ .Service.Name.DNSCase }}-secrets"
                  key: POSTGRES_PWD
            - name: DBNAME
              value: "temporal"
            - name: VISIBILITY_DBNAME
              value: "temporal_visibility"
            - name: DEFAULT_NAMESPACE
              value: "default"
          resources:
            requests:
              memory: "512Mi"
              cpu: "250m"
            limits:
              memory: "2Gi"
              cpu: "1000m"
